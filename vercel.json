{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog", "destination": "https://blog.fotofinish.com/", "permanent": true },
    { "source": "/blog/:path*", "destination": "https://blog.fotofinish.com/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
